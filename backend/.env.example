
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# Pin the OpenAI-compatible provider to your LLM endpoint (e.g. deepseek).
# Required: otherwise, when MODELSCOPE_API_KEY (used by RAG) is also set,
# HelloAgents auto-selects the modelscope provider and the planner LLM 401s.
LLM_PROVIDER=openai
OPENAI_API_KEY=your-llm-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 服务器配置
HOST=0.0.0.0
PORT=7000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# RAG: ModelScope dense embedding (Qwen3-Embedding-8B)
MODELSCOPE_API_KEY=your-modelscope-key
# RAG: Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
RAG_COLLECTION=travel_documents
RAG_CREDIBILITY_THRESHOLD=0.65

# Critic reflection loop (optional, off by default)
PLANNER_ENABLE_CRITIC=0
PLANNER_MAX_REVISE=2